def changed(result):
    """The lines a tool call's result says it added and removed: "Updated with 6
    additions and 2 removals", "Wrote 61 lines"; none for any other (a read)."""
    added = re.search(r"(\d+) additions?", result) or re.search(r"Wrote (\d+) lines", result)
    removed = re.search(r"(\d+) removals?", result)
    return (int(added.group(1)) if added else 0, int(removed.group(1)) if removed else 0)


def scenario(prompt):
    for keyword, title, steps in SCENARIOS:
        if keyword in prompt.lower():
            return title, steps
    return None, SCENARIOS[-1][2]


def arg(name):
    a = sys.argv[1:]
    return a[a.index(name) + 1] if name in a and a.index(name) + 1 < len(a) else None


def stamp(at=None):
    at = datetime.datetime.fromtimestamp(at or time.time(), datetime.timezone.utc)
    return at.strftime("%Y-%m-%dT%H:%M:%S.") + f"{at.microsecond // 1000:03d}Z"


def report(kind, payload):
    """As roster's pi extension and Codex's hooks do: `roster report <kind>`."""
    subprocess.run([os.environ.get("ROSTER_EXE", "roster"), "report", kind],
                   input=json.dumps(payload), text=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Agent:
    def __init__(self):
        self.cwd = os.getcwd()
        self.lines = []  # the conversation, as (prefix, text, style, a tool's result)
        self.input = ""
        self.steps = []
        self.step_started = 0.0
        self.turn_started = 0.0
        self.asking = None
        self.subagents = []
        self.build = None
        self.context = 18_000
        self.cost = 0.0
        self.added = 0
        self.removed = 0
        self.replies = 0
        self.prompts = 0
        getattr(self, "start_" + PERSONA)()

    # Claude: hooks from --settings, a transcript in its projects directory.
    def start_claude(self):
        self.session_id = arg("--session-id") or arg("--resume") or str(uuid.uuid4())
        resumed = arg("--resume") is not None and arg("--fork-session") is None
        self.alias = arg("--model") or "opus"
        self.model = MODELS.get(self.alias, self.alias)
        self.effort = arg("--effort")
        self.hooks = json.loads(arg("--settings") or "{}").get("hooks", {})
        home = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
        folder = os.path.join(home, "projects", self.cwd.replace("/", "-"))
        os.makedirs(folder, exist_ok=True)
        self.transcript = os.path.join(folder, self.session_id + ".jsonl")
        if resumed and os.path.exists(self.transcript):
            self.lines.append(("", "Resumed the conversation.", DIM, None))
        self.title("Claude Code")
        self.hook("SessionStart", source="resume" if resumed else "startup", model=self.model)

    # pi: what roster's extension reports, a session file in pi's directory.
    def start_pi(self):
        self.session_id = arg("--session-id") or str(uuid.uuid4())
        self.model = arg("--model") or "gpt-6.1-sol"
        self.alias = self.model
        self.effort = arg("--thinking") or "medium"
        home = os.environ.get("PI_CODING_AGENT_DIR", os.path.expanduser("~/.pi/agent"))
        folder = os.path.join(home, "sessions", "--" + self.cwd.strip("/").replace("/", "-") + "--")
        os.makedirs(folder, exist_ok=True)
        found = glob.glob(os.path.join(folder, f"*_{self.session_id}.jsonl"))
        name = stamp().replace(":", "-").replace(".", "-") + f"_{self.session_id}.jsonl"
        self.transcript = found[0] if found else os.path.join(folder, name)
        self.pi_report("session")

    def pi_report(self, kind, **extra):
        if kind == "session":
            extra = {"conversation_id": self.session_id, "transcript_path": self.transcript,
                     "cleared": False, "started": True, "model": self.model,
                     "effort": self.effort, "title": None, "context_window": 272_000}
        report(kind, extra)

    # Codex: names its conversation, reports from its first turn on, a rollout in
    # its sessions; its first prompt comes on its command line.
    def start_codex(self):
        argv = sys.argv[1:]
        resume = argv[argv.index("resume") + 1] if "resume" in argv else None
        self.session_id = resume or str(uuid.uuid4())
        self.model, self.effort = "gpt-6.1-sol", "medium"
        for a in argv:
            if a.startswith("model="):
                self.model = a.split("=", 1)[1].strip('"')
            elif a.startswith("model_reasoning_effort="):
                self.effort = a.split("=", 1)[1].strip('"')
        self.alias = self.model
        self.home = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
        found = glob.glob(os.path.join(self.home, "sessions", "*", "*", "*",
                                       f"rollout-*-{self.session_id}.jsonl"))
        now = datetime.datetime.now(datetime.timezone.utc)
        folder = os.path.join(self.home, "sessions", now.strftime("%Y/%m/%d"))
        os.makedirs(folder, exist_ok=True)
        name = f"rollout-{now.strftime('%Y-%m-%dT%H-%M-%S')}-{self.session_id}.jsonl"
        self.transcript = found[0] if found else os.path.join(folder, name)
        self.reported = False
        if not found:
            self.record({"type": "session_meta", "payload": {"id": self.session_id,
                                                             "cwd": self.cwd}})
        prompt = argv[argv.index("--") + 1] if "--" in argv[:-1] else None
        if prompt:
            self.submit(prompt)

    def codex_report(self, kind, **extra):
        payload = {"session_id": self.session_id, "transcript_path": self.transcript,
                   "cwd": self.cwd, "model": self.model,
                   "source": "startup", **extra}
        if not self.reported:
            self.reported = True
            report("session", payload)
        report(kind, payload)

    # What each agent hears of: a hook (Claude), a report (pi, Codex).
    def hook(self, event, **extra):
        if PERSONA == "claude":
            payload = {"session_id": self.session_id, "transcript_path": self.transcript,
                       "cwd": self.cwd, "hook_event_name": event, **extra}
            for group in self.hooks.get(event, []):
                for h in group.get("hooks", []):
                    subprocess.run(["sh", "-c", h["command"]], input=json.dumps(payload),
                                   text=True, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
            return
        kind = {"UserPromptSubmit": "prompt", "PostToolUse": "working",
                "PermissionRequest": "needs-input", "Stop": "idle"}.get(event)
        if kind and PERSONA == "pi":
            self.pi_report(kind)
        elif kind:
            self.codex_report(kind)

    def record(self, entry, path=None):
        with open(path or self.transcript, "a") as f:
            f.write(json.dumps(entry, separators=(",", ":")) + "\n")

    def title(self, text):
        """The task named as the agent names it: Claude in its terminal title, Codex
        with its conversation; pi doesn't (roster titles it after its first turn)."""
        if PERSONA == "claude":
            sys.stdout.write(f"\033]2;✳ {text}\007")
        elif PERSONA == "codex":
            with open(os.path.join(self.home, "session_index.jsonl"), "a") as f:
                f.write(json.dumps({"id": self.session_id, "thread_name": text,
                                    "updated_at": stamp()}, separators=(",", ":")) + "\n")

    def submit(self, prompt):
        self.prompts += 1
        self.lines.append(("> ", prompt, DIM, None))
        self.hook("UserPromptSubmit", prompt=prompt)
        if PERSONA == "claude":
            self.record({"type": "user", "cwd": self.cwd, "timestamp": stamp(),
                         "message": {"content": prompt}})
        elif PERSONA == "pi":
            self.record({"type": "message", "id": f"u{self.prompts}", "timestamp": stamp(),
                         "message": {"role": "user",
                                     "content": [{"type": "text", "text": prompt}]}})
        else:
            self.record({"type": "turn_context", "timestamp": stamp(),
                         "payload": {"model": self.model, "effort": self.effort}})
            self.record({"type": "response_item", "timestamp": stamp(), "payload": {
                "type": "message", "role": "user",
                "content": [{"type": "input_text", "text": prompt}],
                "internal_chat_message_metadata_passthrough": {
                    "content_item_kinds": ["user.text"]}}})
        title, steps = scenario(prompt)
        if title and self.prompts == 1:
            self.title(title)
            if PERSONA == "claude":
                self.record({"type": "ai-title", "aiTitle": title})
        self.steps = list(steps)
        self.turn_started = self.step_started = time.time()

    def reply(self, output_tokens, text=None):
        self.replies += 1
        self.context += 3_000 + 1_700 * (self.replies % 5)
        self.cost += 0.04 + output_tokens / 40_000
        if PERSONA == "claude":
            content = [{"type": "text", "text": text}] if text else []
            self.record({"type": "assistant", "cwd": self.cwd, "timestamp": stamp(),
                         "message": {"id": f"msg-{self.session_id[:8]}-{self.replies}",
                                     "model": self.model, "content": content,
                                     "usage": {"input_tokens": 4,
                                               "cache_read_input_tokens": self.context,
                                               "cache_creation_input_tokens": 0,
                                               "output_tokens": output_tokens}}})
        elif PERSONA == "pi":
            content = [{"type": "text", "text": text}] if text else []
            self.record({"type": "message", "id": f"a{self.replies}", "timestamp": stamp(),
                         "message": {"role": "assistant", "provider": "openai",
                                     "model": self.model, "content": content,
                                     "usage": {"input": 900, "output": output_tokens,
                                               "cacheRead": self.context, "cacheWrite": 0,
                                               "cost": {"total": round(0.01 + output_tokens / 50_000, 4)}}}})
        else:
            if text:
                self.record({"type": "response_item", "timestamp": stamp(), "payload": {
                    "type": "message", "role": "assistant",
                    "content": [{"type": "output_text", "text": text}]}})
            usage = {"input_tokens": self.context, "cached_input_tokens": self.context - 900,
                     "output_tokens": output_tokens,
                     "total_tokens": self.context + output_tokens}
            self.record({"type": "token_usage_record", "timestamp": stamp(),
                         "payload": {"usage": usage}})
            self.record({"type": "event_msg", "timestamp": stamp(), "payload": {
                "type": "token_count", "info": {
                    "total_token_usage": usage, "last_token_usage": usage,
                    "model_context_window": 272_000}}})

    def advance(self, now):
        """Finishes the current step once its time is up and starts the next."""
        while self.steps and not self.asking:
            step = self.steps[0]
            if step[0] == "ask":
                self.asking = step
                self.hook("PermissionRequest", tool_name=step[1],
                          tool_input={"command": step[2]})
                return
            if step[0] == "agents" and not self.at_work(step, now):
                return
            if step[0] == "build" and not self.built(step, now):
                return
            took = step[-1] if step[0] in ("think", "tool") else 0
            if now - self.step_started < took:
                return
            self.steps.pop(0)
            self.step_started = now
            if step[0] == "tool":
                self.lines.append(("● ", step[1], GREEN, step[2]))
                self.edited(step[1], step[2])
                self.reply(400)
                self.hook("PostToolUse", tool_name=step[1].split("(")[0])
            elif step[0] == "say":
                self.lines.append(("● ", step[1], "", None))
                self.reply(900, step[1])
                if PERSONA == "claude":
                    self.record({"type": "cost-state", "totalCostUSD": round(self.cost, 2),
                                 "totalLinesAdded": self.added,
                                 "totalLinesRemoved": self.removed})
                if not self.steps:
                    self.hook("Stop", **({"effort": {"level": self.effort}}
                                         if PERSONA == "claude" and self.effort else {}))

    def edited(self, call, result):
        """The lines a call changed: Claude counts them in its cost state, Codex
        writes the patch it applied."""
        added, removed = changed(result)
        if not (added or removed):
            return
        self.added += added
        self.removed += removed
        if PERSONA == "codex":
            path = call[call.find("(") + 1:call.rfind(")")]
            change = ({"type": "add", "content": "x\n" * added} if call.startswith("Write")
                      else {"type": "update", "unified_diff": "@@ -1 +1 @@\n" + "+x\n" * added
                            + "-x\n" * removed})
            self.record({"type": "event_msg", "timestamp": stamp(), "payload": {
                "type": "patch_apply_end", "success": True, "changes": {path: change}}})

    def at_work(self, step, now):
        """Its subagents at work, each a step at a time in its own transcript:
        whether they're all done."""
        if not self.subagents:
            folder = os.path.join(os.path.splitext(self.transcript)[0], "subagents")
            os.makedirs(folder, exist_ok=True)
            for sid, kind, task, model, todo in step[1]:
                path = os.path.join(folder, f"agent-{sid}.jsonl")
                with open(os.path.join(folder, f"agent-{sid}.meta.json"), "w") as f:
                    json.dump({"agentType": kind, "description": task, "model": model}, f)
                self.record({"type": "user", "timestamp": stamp(),
                             "message": {"role": "user", "content": task}}, path)
                self.subagents.append({"id": sid, "kind": kind, "task": task, "path": path,
                                       "model": MODELS.get(model, model), "todo": list(todo),
                                       "since": now, "n": 0})
                self.lines.append(("● ", f"Task({kind}: {task})", ACCENT, None))
                self.hook("SubagentStart", agent_id=sid, agent_type=kind)
            return False
        for s in self.subagents:
            if s["todo"] and now - s["since"] >= s["todo"][0][2]:
                s["todo"].pop(0)
                s["since"] = now
                if not s["todo"]:
                    self.hook("SubagentStop", agent_id=s["id"], agent_transcript_path=s["path"])
            # Its step now, as Claude writes a tool call as it makes it.
            if s["todo"] and s["n"] == len(s["todo"]):
                continue
            if s["todo"]:
                s["n"] = len(s["todo"])
                tool, given, _ = s["todo"][0]
                self.record({"type": "assistant", "timestamp": stamp(), "message": {
                    "id": f"msg-{s['id']}-{s['n']}", "model": s["model"],
                    "content": [{"type": "tool_use", "id": f"t-{s['id']}-{s['n']}",
                                 "name": tool, "input": given}],
                    "usage": {"input_tokens": 3, "cache_read_input_tokens": 12_000,
                              "cache_creation_input_tokens": 0, "output_tokens": 150}}},
                    s["path"])
        if any(s["todo"] for s in self.subagents):
            return False
        self.subagents = []
        return True

    def built(self, step, now):
        """A build growing till it's killed: whether it's ended."""
        _, command, rate, most = step
        if self.build is None:
            code = ("import ctypes, time\n"
                    "ctypes.CDLL(None).prctl(15, b'node', 0, 0, 0)\n"
                    "kept = []\n"
                    f"while len(kept) * 10 < {most}:\n"
                    "    kept.append(b'x' * (10 << 20))\n"
                    f"    time.sleep(10 / {rate})\n"
                    "time.sleep(3600)\n")
            self.build = subprocess.Popen([PYTHON, "-c", code],
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.hook("PostToolUse", tool_name="Bash")
            return False
        if self.build.poll() is None:
            return False
        self.lines.append(("● ", f"Bash({command})", GREEN, "Killed"))
        self.build = None
        return True

    def answer(self, yes):
        self.steps.pop(0)
        self.asking = None
        self.step_started = time.time()
        if not yes:
            self.steps = [("say", "OK, I won't run it. What should I do instead?")]
        elif PERSONA != "claude":
            self.hook("PostToolUse")

    def key(self, c):
        if self.asking:
            if c in ("1", "y", "\r", "\n"):
                self.answer(True)
            elif c in ("2", "3", "n", "\x1b"):
                self.answer(False)
        elif self.steps:
            return
        elif c in ("\r", "\n"):
            if self.input.strip():
                self.submit(self.input.strip())
            self.input = ""
        elif c in ("\x7f", "\b"):
            self.input = self.input[:-1]
        elif c.isprintable():
            self.input += c

    def draw(self, now):
        cols, rows = os.get_terminal_size(sys.stdout.fileno())
        width = max(20, cols - 1)
        out = []
        box = width - 2
        home = self.cwd.replace(os.path.expanduser("~"), "~", 1)
        mark, name = MARKS.get(PERSONA, "✻"), NAMES.get(PERSONA, "Claude Code")
        out.append(ACCENT + "╭" + "─" * box + "╮" + RESET)
        for text in [f"{BOLD}{mark} Demo agent{RESET}{DIM}, a scripted stand-in for {name}",
                     f"  {self.alias} · {home}"]:
            visible = len(strip(text))
            out.append(ACCENT + "│ " + RESET + text + RESET + " " * max(0, box - 1 - visible)
                       + ACCENT + "│" + RESET)
        out.append(ACCENT + "╰" + "─" * box + "╯" + RESET)
        out.append("")
        body = []
        for prefix, text, style, result in self.lines:
            for i, part in enumerate(wrap(text, width - len(prefix))):
                lead = prefix if i == 0 else " " * len(prefix)
                body.append(style + lead + part + RESET)
            if result:
                body.append(DIM + "  └ " + result + RESET)
            body.append("")
        bottom = []
        if self.steps and not self.asking:
            step = self.steps[0]
            if step[0] == "tool":
                body.append(DIM + "● " + step[1] + RESET)
            elif step[0] == "build":
                body.append(DIM + f"● Bash({step[1]})" + RESET)
            spin = SPINNER[int(now * 8) % len(SPINNER)]
            verb = VERBS[int(self.turn_started) % len(VERBS)]
            seconds = int(now - self.turn_started)
            at_work = f" · {len(self.subagents)} agents at work" if self.subagents else ""
            bottom.append(f"{ACCENT}{spin} {verb}…{RESET}{DIM} ({seconds}s{at_work}"
                          f" · esc to interrupt){RESET}")
            bottom.append("")
        if self.asking:
            _, tool, command = self.asking
            bottom += [ACCENT + "╭" + "─" * box + "╮" + RESET]
            for text in [f"{BOLD}{tool} command{RESET}", "", f"  {command}", "",
                         "Do you want to proceed?", f"{ACCENT}> 1. Yes{RESET}",
                         "  2. No, and tell the agent what to do differently"]:
                visible = len(strip(text))
                bottom.append(ACCENT + "│ " + RESET + text + RESET
                              + " " * max(0, box - 1 - visible) + ACCENT + "│" + RESET)
            bottom.append(ACCENT + "╰" + "─" * box + "╯" + RESET)
        else:
            text = "> " + self.input + ("█" if not self.steps else "")
            bottom += [DIM + "╭" + "─" * box + "╮" + RESET,
                       DIM + "│ " + RESET + text + " " * max(0, box - 1 - len(text))
                       + DIM + "│" + RESET,
                       DIM + "╰" + "─" * box + "╯" + RESET,
                       DIM + "  ? for shortcuts" + RESET]
        # Like Claude: the input follows the conversation, which scrolls up once
        # the screen is full.
        room = max(0, rows - len(out) - len(bottom))
        screen = out + (body[-room:] if room else []) + bottom
        sys.stdout.write("\033[H" + "\r\n".join(line + "\033[K" for line in screen[:rows])
                         + "\033[J")
        sys.stdout.flush()


def strip(text):
    out, skip = "", False
    for c in text:
        if c == "\033":
            skip = True
        elif skip:
            skip = c != "m"
        else:
            out += c
    return out


def wrap(text, width):
    lines, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            lines.append(line)
            line = word
        else:
            line = f"{line} {word}" if line else word
    return lines + [line]


def resets(seconds, iso):
    at = time.time() + seconds
    if not iso:
        return int(at)
    return datetime.datetime.fromtimestamp(at, datetime.timezone.utc).isoformat()


def claude_sdk():
    """Claude's SDK mode, as roster asks it its plan's limits: each control
    request answered, till its input ends."""
    limits = {name: {"utilization": used, "resets_at": resets(left, True)}
              for name, (used, left) in LIMITS.items()}
    for line in sys.stdin:
        try:
            request = json.loads(line)
        except ValueError:
            continue
        subtype = request.get("request", {}).get("subtype")
        body = {"subscription_type": "max", "rate_limits_available": True,
                "rate_limits": limits} if subtype == "get_usage" else {}
        print(json.dumps({"type": "control_response", "response": {
            "subtype": "success", "request_id": request.get("request_id"),
            "response": body}}), flush=True)


def codex_server():
    """`codex app-server`, as roster asks it the account's limits: each request
    answered, till its input ends."""
    (five, five_left), (week, week_left) = LIMITS["five_hour"], LIMITS["seven_day"]
    five, week = five - 26, week - 34
    for line in sys.stdin:
        try:
            request = json.loads(line)
        except ValueError:
            continue
        method = request.get("method")
        if method == "initialize":
            print(json.dumps({"id": request["id"], "result": {"userAgent": "demo"}}), flush=True)
        elif method == "account/rateLimits/read":
            print(json.dumps({"id": request["id"], "result": {"rateLimits": {
                "limitId": "codex",
                "primary": {"usedPercent": five, "windowDurationMins": 300,
                            "resetsAt": resets(five_left, False)},
                "secondary": {"usedPercent": week, "windowDurationMins": 10080,
                              "resetsAt": resets(week_left, False)},
                "planType": "pro"}}}), flush=True)


def oneoff():
    """A one-off run (for a title): the title of what the prompt asks."""
    prompt = sys.argv[-1]
    for keyword, title, _ in SCENARIOS:
        if keyword and keyword in prompt.lower():
            print(title)
            return
    print("A demo session")


def main():
    argv = sys.argv[1:]
    if PERSONA == "claude" and "stream-json" in argv:
        return claude_sdk()
    if PERSONA == "codex" and argv[:1] == ["app-server"]:
        return codex_server()
    if (PERSONA in ("claude", "pi") and "-p" in argv) or (PERSONA == "codex" and argv[:1] == ["exec"]):
        return oneoff()
    # Its processes' names the agent's too, as the server view lists them.
    import ctypes
    ctypes.CDLL(None).prctl(15, PERSONA.encode(), 0, 0, 0)
    # Asked something it doesn't answer (models to list): nothing.
    if not sys.stdin.isatty():
        sys.exit(1)
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        sys.stdout.write("\033[?25l\033[2J")
        agent = Agent()
        while True:
            now = time.time()
            agent.advance(now)
            agent.draw(now)
            ready, _, _ = select.select([fd], [], [], 0.1)
            if ready:
                for c in os.read(fd, 1024).decode(errors="ignore"):
                    if c == "\x03":
                        return
                    agent.key(c)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h\r\n")


if __name__ == "__main__":
    main()
