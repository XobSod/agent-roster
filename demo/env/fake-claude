#!/usr/bin/env python3
"""A scripted stand-in for Claude Code, so the demo needs no account, costs nothing
and plays the same every time. Roster starts it like Claude (`--session-id` or
`--resume`, `--settings` with its hooks, `--model`); it reports through those
hooks, keeps a transcript for roster's statistics and sets the pane title the way
Claude does. What it does after a prompt comes from SCENARIOS, by keyword."""

import json
import os
import select
import subprocess
import sys
import termios
import time
import tty

# Steps: ("think", seconds), ("tool", call, result, seconds), ("ask", tool, command),
# ("say", text). A step's seconds are how long it takes; "ask" waits for an answer.
