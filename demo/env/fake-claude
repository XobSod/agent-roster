MODELS = {"opus": "claude-opus-5-5", "sonnet": "claude-sonnet-5-5", "haiku": "claude-haiku-5-5"}
SPINNER = "·✢✳✶✻✽✻✶✳✢"
VERBS = ["Thinking", "Pondering", "Reasoning", "Working"]

ACCENT, DIM, GREEN, RED, BOLD, RESET = (
    "\033[38;5;173m", "\033[2m", "\033[32m", "\033[31m", "\033[1m", "\033[0m")


def arg(name):
    a = sys.argv[1:]
    return a[a.index(name) + 1] if name in a and a.index(name) + 1 < len(a) else None


class Agent:
    def __init__(self):
        self.session_id = arg("--session-id") or arg("--resume") or "demo"
        resumed = arg("--resume") is not None and arg("--fork-session") is None
        alias = arg("--model") or "opus"
        self.model = MODELS.get(alias, alias)
        self.alias = alias
        self.cwd = os.getcwd()
        self.hooks = json.loads(arg("--settings") or "{}").get("hooks", {})
        claude = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
        folder = os.path.join(claude, "projects", self.cwd.replace("/", "-"))
        os.makedirs(folder, exist_ok=True)
        self.transcript = os.path.join(folder, self.session_id + ".jsonl")
        self.lines = []  # the conversation, as (prefix, text, style, a tool's result)
        self.input = ""
        self.steps = []
        self.step_started = 0.0
        self.turn_started = 0.0
        self.asking = None
        self.context = 18_000
        self.cost = 0.0
        self.added = 0
        self.replies = 0
        if resumed and os.path.exists(self.transcript):
            self.lines.append(("", "Resumed the conversation.", DIM, None))
        self.title("Claude Code")
        self.hook("SessionStart", source="resume" if resumed else "startup", model=self.model)

    def hook(self, event, **extra):
        payload = {"session_id": self.session_id, "transcript_path": self.transcript,
                   "cwd": self.cwd, "hook_event_name": event, **extra}
        for group in self.hooks.get(event, []):
            for h in group.get("hooks", []):
                subprocess.run(["sh", "-c", h["command"]], input=json.dumps(payload),
                               text=True, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)

    def record(self, entry):
        with open(self.transcript, "a") as f:
            f.write(json.dumps(entry) + "\n")

    def title(self, text):
        sys.stdout.write(f"\033]2;✳ {text}\007")

    def submit(self, prompt):
        self.lines.append(("> ", prompt, DIM, None))
        self.hook("UserPromptSubmit", prompt=prompt)
        self.record({"type": "user", "cwd": self.cwd, "message": {"content": prompt}})
        for keyword, title, steps in SCENARIOS:
            if keyword in prompt.lower():
                break
        if title:
            self.title(title)
            self.record({"type": "ai-title", "aiTitle": title})
        self.steps = list(steps)
        self.turn_started = self.step_started = time.time()

    def reply(self, output_tokens):
        self.replies += 1
        self.context += 3_000 + 1_700 * (self.replies % 5)
        self.cost += 0.04 + output_tokens / 40_000
        self.record({"type": "assistant", "cwd": self.cwd, "message": {
            "id": f"msg-{self.session_id[:8]}-{self.replies}", "model": self.model,
            "usage": {"input_tokens": 4, "cache_read_input_tokens": self.context,
                      "cache_creation_input_tokens": 0, "output_tokens": output_tokens}}})

    def advance(self, now):
        """Finishes the current step once its time is up and starts the next."""
        while self.steps and not self.asking:
            step = self.steps[0]
            if step[0] == "ask":
                self.asking = step
                self.hook("PermissionRequest", tool_name=step[1],
                          tool_input={"command": step[2]})
                return
            took = step[-1] if step[0] in ("think", "tool") else 0
            if now - self.step_started < took:
                return
            self.steps.pop(0)
            self.step_started = now
            if step[0] == "tool":
                self.lines.append(("● ", step[1], GREEN, step[2]))
                self.added += 7
                self.reply(400)
                self.hook("PostToolUse", tool_name=step[1].split("(")[0])
            elif step[0] == "say":
                self.lines.append(("● ", step[1], "", None))
                self.reply(900)
                self.record({"type": "cost-state", "totalCostUSD": round(self.cost, 2),
                             "totalLinesAdded": self.added, "totalLinesRemoved": self.added // 4})
                if not self.steps:
                    self.hook("Stop")

    def answer(self, yes):
        self.steps.pop(0)
        self.asking = None
        self.step_started = time.time()
        if not yes:
            self.steps = [("say", "OK, I won't run it. What should I do instead?")]

    def key(self, c):
        if self.asking:
            if c in ("1", "y", "\r", "\n"):
                self.answer(True)
            elif c in ("2", "3", "n", "\x1b"):
                self.answer(False)
        elif self.steps:
            return
        elif c in ("\r", "\n"):
            if self.input.strip():
                self.submit(self.input.strip())
            self.input = ""
        elif c in ("\x7f", "\b"):
            self.input = self.input[:-1]
        elif c.isprintable():
            self.input += c

    def draw(self, now):
        cols, rows = os.get_terminal_size(sys.stdout.fileno())
        width = max(20, min(cols - 1, 100))
        out = []
        box = width - 2
        home = self.cwd.replace(os.path.expanduser("~"), "~", 1)
        out.append(ACCENT + "╭" + "─" * box + "╮" + RESET)
        for text in [f"{BOLD}✻ Demo agent{RESET}{DIM}, a scripted stand-in for Claude Code",
                     f"  {self.alias} · {home}"]:
            visible = len(strip(text))
            out.append(ACCENT + "│ " + RESET + text + RESET + " " * max(0, box - 1 - visible)
                       + ACCENT + "│" + RESET)
        out.append(ACCENT + "╰" + "─" * box + "╯" + RESET)
        out.append("")
        body = []
        for prefix, text, style, result in self.lines:
            for i, part in enumerate(wrap(text, width - len(prefix))):
                lead = prefix if i == 0 else " " * len(prefix)
                body.append(style + lead + part + RESET)
            if result:
                body.append(DIM + "  └ " + result + RESET)
            body.append("")
        bottom = []
        if self.steps and not self.asking:
            step = self.steps[0]
            if step[0] == "tool":
                body.append(DIM + "● " + step[1] + RESET)
            spin = SPINNER[int(now * 8) % len(SPINNER)]
            verb = VERBS[int(self.turn_started) % len(VERBS)]
            seconds = int(now - self.turn_started)
            bottom.append(f"{ACCENT}{spin} {verb}…{RESET}{DIM} ({seconds}s · esc to interrupt){RESET}")
            bottom.append("")
        if self.asking:
            _, tool, command = self.asking
            bottom += [ACCENT + "╭" + "─" * box + "╮" + RESET]
            for text in [f"{BOLD}{tool} command{RESET}", "", f"  {command}", "",
                         "Do you want to proceed?", f"{ACCENT}> 1. Yes{RESET}",
                         "  2. No, and tell the agent what to do differently"]:
                visible = len(strip(text))
                bottom.append(ACCENT + "│ " + RESET + text + RESET
                              + " " * max(0, box - 1 - visible) + ACCENT + "│" + RESET)
            bottom.append(ACCENT + "╰" + "─" * box + "╯" + RESET)
        else:
            text = "> " + self.input + ("█" if not self.steps else "")
            bottom += [DIM + "╭" + "─" * box + "╮" + RESET,
                       DIM + "│ " + RESET + text + " " * max(0, box - 1 - len(text))
                       + DIM + "│" + RESET,
                       DIM + "╰" + "─" * box + "╯" + RESET,
                       DIM + "  ? for shortcuts" + RESET]
        # Like Claude: the input follows the conversation, which scrolls up once
        # the screen is full.
        room = max(0, rows - len(out) - len(bottom))
        screen = out + (body[-room:] if room else []) + bottom
        sys.stdout.write("\033[H" + "\r\n".join(line + "\033[K" for line in screen[:rows])
                         + "\033[J")
        sys.stdout.flush()


def strip(text):
    out, skip = "", False
    for c in text:
        if c == "\033":
            skip = True
        elif skip:
            skip = c != "m"
        else:
            out += c
    return out


def wrap(text, width):
    lines, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            lines.append(line)
            line = word
        else:
            line = f"{line} {word}" if line else word
    return lines + [line]


def main():
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    tty.setraw(fd)
    sys.stdout.write("\033[?25l\033[2J")
    agent = Agent()
    try:
        while True:
            now = time.time()
            agent.advance(now)
            agent.draw(now)
            ready, _, _ = select.select([fd], [], [], 0.1)
            if ready:
                for c in os.read(fd, 1024).decode(errors="ignore"):
                    if c == "\x03":
                        return
                    agent.key(c)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h\r\n")


if __name__ == "__main__":
    main()
